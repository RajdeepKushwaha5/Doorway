# NOTICE environment variables
# Copy to .env and fill in. Never commit .env.
# Names only in this file, never values.
#
# Only BRIGHTDATA_API_KEY is required. Everything else has a working default.

# --- Required ------------------------------------------------------------

# Bright Data account API key. Server-side only, never in a browser bundle.
# Get it from https://brightdata.com/cp/setting/users, or run `bdata login`
# and read it back from the CLI config it writes.
BRIGHTDATA_API_KEY=

# Unlocker zone for the independent witness. Strongly recommended: without it
# the witness falls back to the `bdata` CLI, which does not exist on a deployed
# host. The CLI creates a zone named `cli_unlocker` on first login.
BRIGHTDATA_UNLOCKER_ZONE=

# Bearer token required by every mutating API route. Unset means those routes
# are disabled entirely rather than open.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTICE_ADMIN_TOKEN=

# --- DriftMart (only if you run the controlled fixture) -------------------

# Any long random string you invent. Guards the mode-switch endpoint, which
# has to be publicly reachable so Bright Data can fetch the pages, and would
# otherwise let a passer-by flip the page mid-run.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRIFTMART_ADMIN_TOKEN=

# --- Optional, all have defaults -----------------------------------------

# Bright Data API base. Override only if support tells you to.
# BRIGHTDATA_API_BASE=https://api.brightdata.com

# Port for the NOTICE API. Default 4000.
# PORT=4000

# Where the file-backed store lives. Default ./data/notice.json
# NOTICE_DATA_FILE=./data/notice.json

# Allowed browser origin for the dashboard. Default "*".
# Set this to your deployed frontend URL in production.
# NOTICE_CORS_ORIGIN=https://your-dashboard.vercel.app

# How often the worker looks for collectors that are due, in seconds.
# NOTICE_SCHEDULER_INTERVAL_S=60

# Minimum gap between runs of the same collector, in seconds. Default 6 hours.
# Monitoring is about catching a redesign, which happens over days. Polling
# harder mostly burns credits.
# NOTICE_MIN_INTERVAL_S=21600

# Ceiling on collectors observed per tick, to bound credit burn.
# NOTICE_MAX_PER_TICK=5

# --- Frontend (set in frontend/.env.local, not here) ----------------------

# Where the dashboard finds the API. Default http://localhost:4000
# Read at build time, not at runtime, so a change needs a rebuild.
# NEXT_PUBLIC_NOTICE_API_BASE=http://localhost:4000

# Public origin of the dashboard, used to resolve metadata and share links.
# Default http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://your-dashboard.vercel.app

# Same bearer token as NOTICE_ADMIN_TOKEN above. Set it on the dashboard host
# too: mutations run in server actions, never in the browser, so the token
# stays server-side. Deliberately has no NEXT_PUBLIC_ prefix, which would put
# it in the browser bundle.
# NOTICE_ADMIN_TOKEN=

# Overrides the API base for server-side calls only, for a host that routes
# internal traffic over a private hostname. Falls back to the public value.
# NOTICE_API_BASE=
