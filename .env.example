# NOTICE environment variables
# Copy to .env and fill in. Never commit .env.
# Names only in this file, never values.
#
# Only BRIGHTDATA_API_KEY is required. Everything else has a working default.

# --- Required ------------------------------------------------------------

# Bright Data account API key. Server-side only, never in a browser bundle.
# Get it from https://brightdata.com/cp/setting/users, or run `bdata login`
# and read it back from the CLI config it writes.
BRIGHTDATA_API_KEY=

# Where the witness fetches from, ISO 3166-1 alpha-2, for example `us`.
#
# Strongly recommended for any site that prices or stocks by region. The two
# sensors are only comparable when they saw the same page, and left unset
# Bright Data picks the optimal exit per request, which can differ between two
# calls to the same URL. The value is recorded on every observation so a
# regional difference is classified as `access_anomaly` rather than blamed on
# the collector.
# BRIGHTDATA_UNLOCKER_COUNTRY=us

# Which layout the witness asks for: `desktop` (default) or `mobile`.
#
# Set this to match what your collector sees. Scraper Studio can emulate a
# phone with `emulate_device`, and a mobile page can legitimately show a
# different price, so a collector on mobile compared against a desktop witness
# produces a disagreement that is real rather than a fault. Both sides are
# recorded on every observation, so the mismatch is reported as an access
# anomaly instead of being blamed on the extractor.
# BRIGHTDATA_UNLOCKER_DEVICE=desktop

# Unlocker zone for the independent witness. Strongly recommended: without it
# the witness falls back to the `bdata` CLI, which does not exist on a deployed
# host. The CLI creates a zone named `cli_unlocker` on first login.
BRIGHTDATA_UNLOCKER_ZONE=

# Bearer token required by every mutating API route. Unset means those routes
# are disabled entirely rather than open.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTICE_ADMIN_TOKEN=

# Inbound webhook told whenever data stops being trustworthy. Optional.
#
# Slack, Discord, Teams and every incident tool accept a URL taking JSON, so
# one setting covers all of them. The payload leads with `text`, which is the
# field those services render.
#
# Only fires for verdicts a person should act on. A genuine source change is
# deliberately silent: waking someone to say nothing is wrong is how an alert
# gets muted, and a muted alert is worse than none because it looks like
# coverage.
# NOTICE_WEBHOOK_URL=

# Dashboard origin, so a notification can link straight to the incident.
# NOTICE_DASHBOARD_URL=https://your-dashboard.vercel.app

# File incidents as GitHub issues. Optional, both required together.
#
# A chat message scrolls past. An issue has an owner, a thread and a close
# date, which is what a team actually works from. One issue per collector and
# field, not per run, so an unresolved fault does not file four a day.
# NOTICE_GITHUB_REPO=owner/repo
# NOTICE_GITHUB_TOKEN=

# Public origin of this API, so an issue can embed the incident screenshot.
# NOTICE_PUBLIC_API_URL=https://your-api.onrender.com

# --- DriftMart (only if you run the controlled fixture) -------------------

# Any long random string you invent. Guards the mode-switch endpoint, which
# has to be publicly reachable so Bright Data can fetch the pages, and would
# otherwise let a passer-by flip the page mid-run.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRIFTMART_ADMIN_TOKEN=

# --- Optional, all have defaults -----------------------------------------

# Bright Data API base. Override only if support tells you to.
# BRIGHTDATA_API_BASE=https://api.brightdata.com

# Port for the NOTICE API. Default 4000.
# PORT=4000

# Where the file-backed store lives. Default ./data/notice.json
# NOTICE_DATA_FILE=./data/notice.json

# Allowed browser origin for the dashboard. Default "*".
# Set this to your deployed frontend URL in production.
# NOTICE_CORS_ORIGIN=https://your-dashboard.vercel.app

# How often the worker looks for collectors that are due, in seconds.
# NOTICE_SCHEDULER_INTERVAL_S=60

# Minimum gap between runs of the same collector, in seconds. Default 6 hours.
# Monitoring is about catching a redesign, which happens over days. Polling
# harder mostly burns credits.
# NOTICE_MIN_INTERVAL_S=21600

# Ceiling on collectors observed per tick, to bound credit burn.
# NOTICE_MAX_PER_TICK=5

# Monthly page-load ceiling for scheduled monitoring. Default 4000.
#
# Bright Data grants 5,000 page loads a month, renewed monthly, and both the
# collector and the Web Unlocker witness draw from that one pool, so every
# observation costs two. Ten collectors on the default six-hour interval spend
# about 2,400 a month. The same ten hourly spend roughly 14,400, and nothing
# would look wrong until the bill arrived, so the scheduler pauses instead.
#
# The default sits below 5,000 on purpose: manual runs, heal replays and
# incident screenshots draw from the same pool without passing through this
# counter.
# NOTICE_MONTHLY_PAGE_LOAD_BUDGET=4000

# --- Frontend (set in frontend/.env.local, not here) ----------------------

# Where the dashboard finds the API. Default http://localhost:4000
# Read at build time, not at runtime, so a change needs a rebuild.
# NEXT_PUBLIC_NOTICE_API_BASE=http://localhost:4000

# Public origin of the dashboard, used to resolve metadata and share links.
# Default http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://your-dashboard.vercel.app

# Same bearer token as NOTICE_ADMIN_TOKEN above. Set it on the dashboard host
# too: mutations run in server actions, never in the browser, so the token
# stays server-side. Deliberately has no NEXT_PUBLIC_ prefix, which would put
# it in the browser bundle.
# NOTICE_ADMIN_TOKEN=

# Overrides the API base for server-side calls only, for a host that routes
# internal traffic over a private hostname. Falls back to the public value.
# NOTICE_API_BASE=
