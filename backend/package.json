{
  "name": "@notice/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "dev": "concurrently --kill-others --names types,server \"npm run dev:types\" \"npm run dev:server\"",
    "dev:types": "tsc --build --watch --preserveWatchOutput",
    "dev:server": "node --env-file-if-exists=../.env --watch dist/src/server.js",
    "start": "node --env-file-if-exists=../.env dist/src/server.js",
    "worker": "node --env-file-if-exists=../.env dist/src/worker/index.js",
    "notice": "node --env-file-if-exists=../.env dist/scripts/notice.js",
    "phase0": "node --env-file-if-exists=../.env dist/scripts/phase0-matrix.js",
    "clean": "rimraf dist *.tsbuildinfo",
    "seed": "node --env-file-if-exists=../.env dist/scripts/seed-demo.js",
    "prove": "node --env-file-if-exists=../.env dist/scripts/prove.js",
    "live": "node --env-file-if-exists=../.env dist/scripts/live.js",
    "mcp": "node --env-file-if-exists=../.env dist/scripts/mcp.js",
    "blindspot": "node --env-file-if-exists=../.env dist/scripts/blindspot.js",
    "benchmark": "node --env-file-if-exists=../.env dist/scripts/benchmark.js",
    "doorway:seed": "node --env-file-if-exists=../.env dist/scripts/doorway-seed.js",
    "discover:test": "node --env-file-if-exists=../.env dist/scripts/discover-test.js",
    "crawl:test": "node --env-file-if-exists=../.env dist/scripts/crawl-test.js",
    "index:fill": "node --env-file-if-exists=../.env dist/scripts/fill-index.js",
    "index:export": "node --env-file-if-exists=../.env dist/scripts/export-index.js"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
