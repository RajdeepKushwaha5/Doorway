{
  "name": "@notice/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file-if-exists=../.env --watch dist/src/server.js",
    "start": "node --env-file-if-exists=../.env dist/src/server.js",
    "worker": "node --env-file-if-exists=../.env dist/src/worker/index.js",
    "notice": "node --env-file-if-exists=../.env dist/scripts/notice.js",
    "phase0": "node --env-file-if-exists=../.env dist/scripts/phase0-matrix.js",
    "clean": "rimraf dist *.tsbuildinfo",
    "seed": "node --env-file-if-exists=../.env dist/scripts/seed-demo.js",
    "prove": "node --env-file-if-exists=../.env dist/scripts/prove.js",
    "live": "node --env-file-if-exists=../.env dist/scripts/live.js"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
